          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "engine_version"
        ],
        "title": "AgentInfo",
        "type": "object"
      },
      "AgentInput": {
        "additionalProperties": false,
        "description": "Base input envelope. Subclasses add agent-specific fields.",
        "properties": {
          "born_at": {
            "format": "date-time",
            "title": "Born At",
            "type": "string"
          },
          "born_location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "client_nonce": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Nonce"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender",
            "default": "unknown"
          },
          "locale": {
            "default": "zh-CN",
            "title": "Locale",
            "type": "string"
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "required": [
          "request_id",
          "born_at"
        ],
        "title": "AgentInput",
        "type": "object"
      },
      "AgentOutput": {
        "additionalProperties": false,
        "description": "Base output envelope. Subclasses override ``result`` typing.",
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "computed_at": {
            "format": "date-time",
            "title": "Computed At",
            "type": "string"
          },
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceScore"
          },
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "input_hash": {
            "title": "Input Hash",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Metadata",
            "type": "object"
          },
          "reasoning_trace": {
            "items": {
              "$ref": "#/components/schemas/ReasoningStep"
            },
            "title": "Reasoning Trace",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          }
        },
        "required": [
          "request_id",
          "agent",
          "engine_version",
          "input_hash",
          "computed_at",
          "confidence"
        ],
        "title": "AgentOutput",
        "type": "object"
      },
      "AgentsResponse": {
        "description": "``GET /agents``.",
