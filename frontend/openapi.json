            "type": "array"
          },
          "overall_confidence": {
            "title": "Overall Confidence",
            "type": "number"
          },
          "recommendation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation"
          },
          "synthesis": {
            "title": "Synthesis",
            "type": "string"
          }
