          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "agent",
          "confidence",
          "weight",
          "element",
          "summary"
        ],
        "title": "AgentContribution",
        "type": "object"
      },
      "AgentInfo": {
        "description": "One registered agent as listed by ``GET /agents``.",
