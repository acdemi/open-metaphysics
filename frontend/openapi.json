        "title": "ConsensusOutput",
        "type": "object"
      },
      "ConsensusReport": {
        "additionalProperties": false,
        "properties": {
          "agreement_matrix": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            "title": "Agreement Matrix",
            "type": "object"
          },
          "conflicts": {
            "items": {
              "$ref": "#/components/schemas/Conflict"
