# OpenMetaphysics -- environment template (`OM_*` = Settings fields).
#
# IMPORTANT: the application reads the *process environment* only. It does NOT
# parse this file automatically (there is no dotenv loader / no extra dependency).
# Use it as a template:
#   * docker:   docker compose --env-file .env --profile app up -d
#   * bash:     set -a; . ./.env; set +a
#   * PowerShell: Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item -Path "Env:$($Matches[1].Trim())" -Value $Matches[2].Trim() } }
# Every key below maps 1:1 to a `Settings` field: `ollama_model` -> `OM_OLLAMA_MODEL`.
# Empty value = keep the code default (optional fields become unset/None).

# --- Runtime data directories (knowledge corpora + frozen reference contracts) ---
# Needed after a plain `pip install` / in Docker, where the repository tree is
# not present. Empty = auto-detect the source checkout. In the Docker image the
# two variables are pinned to /app/knowledge and /app/reference.
OM_KNOWLEDGE_DIR=
OM_REFERENCE_DIR=

# --- Inference (opt-in; everything stays offline/deterministic while disabled) ---
OM_ENABLE_EXPLAINER=false
OM_INFERENCE_PROVIDER=ollama          # ollama | qwen | deepseek
OM_EXPLAIN_TEMPERATURE=0.2
OM_EXPLAIN_MAX_TOKENS=512

# Local Ollama (default provider)
OM_OLLAMA_BASE_URL=http://localhost:11434
OM_OLLAMA_MODEL=qwen2.5:7b

# Qwen (DashScope OpenAI-compatible endpoint)
OM_QWEN_API_BASE=
OM_QWEN_API_KEY=
OM_QWEN_MODEL=qwen-plus

# DeepSeek (OpenAI-compatible endpoint)
OM_DEEPSEEK_API_BASE=https://api.deepseek.com
OM_DEEPSEEK_API_KEY=
OM_DEEPSEEK_MODEL=deepseek-chat

# Embeddings for the optional Qdrant RAG path (separate from the chat model).
# Empty = provider default: ollama -> nomic-embed-text, qwen -> text-embedding-v3.
OM_EMBEDDING_MODEL=

# --- RAG (optional; default is the offline InMemory retriever) ---
OM_RAG_ENABLED=false
OM_QDRANT_URL=
OM_QDRANT_COLLECTION=openmetaphysics

# --- Persistence (optional; default is in-memory sessions/traces) ---
OM_POSTGRES_DSN=

# --- Docker Compose service configuration ---
# POSTGRES_PASSWORD is required by docker-compose.yml when starting services.
POSTGRES_USER=om
POSTGRES_PASSWORD=
POSTGRES_DB=openmetaphysics

# Compose port bindings default to loopback. Set to 0.0.0.0 only when remote
# access is explicitly required and protected by a firewall.
OMP_POSTGRES_BIND=127.0.0.1
OMP_QDRANT_HTTP_BIND=127.0.0.1
OMP_QDRANT_GRPC_BIND=127.0.0.1
OMP_VALKEY_BIND=127.0.0.1
OMP_API_BIND=127.0.0.1
OMP_OLLAMA_BIND=127.0.0.1

# --- API (optional; comma-separated CORS origins) ---
OM_CORS_ORIGINS=

# --- API protection (P2.2, opt-in; empty OM_API_KEY = disabled, legacy behaviour) ---
# When OM_API_KEY is set, these routes require a key (Authorization: Bearer or
# X-API-Key): /sessions*, /traces/*, /orchestrate, /agents/{name}/compute|explain
# Rate limiting is an in-memory sliding window; 0 disables it. It is
# process-local: multiple workers/replicas do NOT share counters and this is
# NOT a distributed rate limiter.
OM_API_KEY=
OM_RATE_LIMIT_PER_MINUTE=60
# Redact born_at / born_location from session/trace responses. Birth data is
# sensitive; keep the default (false) only for backwards compatibility, and
# prefer exposing it behind OM_API_KEY.
OM_SESSION_REDACT_BIRTH=false

# --- Orchestration ---
OM_DEFAULT_STRATEGY=weighted
