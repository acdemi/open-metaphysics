# OpenMetaphysics -- Environment Variables (copy to .env)

# PostgreSQL + Apache AGE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=om
POSTGRES_PASSWORD=om_dev
POSTGRES_DB=openmetaphysics
DATABASE_URL=postgresql://om:om_dev@localhost:5432/openmetaphysics

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Valkey (Redis-compatible)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
